# Frontend build-time API URL. Leave blank for local Vite proxying.
VITE_API_BASE_URL=

# Backend and workspace database.
PORT=5001
DATABASE_URL=postgres://fullcode:fullcode_dev_only@localhost:5432/fullcode
CORS_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace-with-a-private-password
PG_POOL_MAX=5

# Optional Lucia Gemini API key. Keep this only in the backend environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
